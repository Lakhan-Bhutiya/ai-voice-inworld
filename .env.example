# Inworld TTS — the Base64 "Copy Base64" value from the Inworld Portal (required for speech)
API_KEY=your_inworld_base64_key_here

# OpenAI — only for the ✨ "Enhance with AI" emotion-tagging button (optional)
OPENAI_API_KEY=sk-your-openai-key-here

# Web UI login — the browser asks for these before the studio loads.
# Leave both blank to disable the login screen entirely.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Optional: fixed secret for signing the login cookie. If unset, one is
# generated on first run and stored in the local SQLite DB (data/app.db),
# so existing logins survive a restart either way.
SESSION_SECRET=

# Optional: comma-separated origins allowed to call the API from another host.
# Same-origin (the bundled UI) needs nothing here.
ALLOWED_ORIGINS=
